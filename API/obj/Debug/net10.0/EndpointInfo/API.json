            ],
            "format": "int32"
          },
          "isApproved": {
            "type": "boolean"
          },
          "topicId": {
            "type": "string"
          },
          "topicName": {
            "type": "string"
          },
          "correctAnswer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SubjectResponseDTO": {
        "required": [
